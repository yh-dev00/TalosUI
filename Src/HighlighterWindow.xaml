<Window x:Class="TalosCore.HighlighterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Highlighter" 
        Height="300" Width="300"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False"
        IsHitTestVisible="False">
    <Border BorderBrush="Yellow" BorderThickness="3" CornerRadius="2">
        <Border.Background>
            <SolidColorBrush Color="Yellow" Opacity="0.1"/>
        </Border.Background>
    </Border>
</Window>